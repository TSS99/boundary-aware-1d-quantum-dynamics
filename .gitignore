# ------------------------------------------------- large binary artefacts --
# Numerical dumps and archives. Everything this project needs is either source,
# a small table, or a vector figure; anything below is either regenerable output
# or something that should live outside version control.
*.npy
*.npz
*.h5
*.hdf5
*.nc
*.pkl
*.pickle
*.joblib
*.qpy
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.mp4
*.mov
*.avi
*.gif
# Raster figures at print resolution. Vector PDF is the archival format here;
# a PNG of the same figure is a convenience copy that git should not carry.
# Delete this rule if a raster is ever the only form a figure exists in.
*.png.orig

# ------------------------------------------------------------------ LaTeX --
# Build artefacts, in case a manuscript directory is ever tracked.
*.aux
*.bbl
*.blg
*.brf
*.fdb_latexmk
*.fls
*.idx
*.ilg
*.ind
*.lof
*.lot
*.nav
*.out
*.snm
*.synctex.gz
*.toc
*.xdv

# ------------------------------------------------------------------ misc ---
*.log

# graphify knowledge graph (generated tooling artefact, ~2 MB)
# Rebuild with: /graphify  (or automatically via the post-commit hook)
graphify-out/

# Manuscript-authoring aid, not part of the scientific record.
# Contains drafting strategy and positioning notes intended for the authors only.
prompt.md

# Manuscript working directory: Springer class files and LaTeX build artefacts.
# Not part of the scientific record; the paper is published by the journal.
manuscript/

